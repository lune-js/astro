{
  "name": "@lune-js/astro",
  "version": "0.2.1",
  "description": "Use Lune within Astro.",
  "bugs": {
    "url": "https://github.com/lune-js/astro/issues"
  },
  "license": "MIT",
  "author": "Gregory Salinas <ags1130@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lune-js/astro.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "astro": "astro",
    "build": "tsdown",
    "clean": "rm -rf .astro dist node_modules",
    "dev": "astro dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fresh": "bun clean && bun install",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "lefthook install",
    "test:e2e": "playwright test",
    "version": "bun changeset version && bun .changeset/postprocess-changelogs.cjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "lune-js": "^1.0.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5",
    "pnpm": ">=7.1.0"
  },
  "packageManager": "bun@1.4.0"
}
